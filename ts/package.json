{
  "name": "tapewasm",
  "version": "0.3.6",
  "description": "Compile an autodiff tape to a WebAssembly module and sample it with nuts-rs, in the browser.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "default": "./browser.js"
    },
    "./browser-worker.js": "./browser-worker.js",
    "./pkg/*": "./pkg/*"
  },
  "files": ["index.js", "index.d.ts", "calibrate.js", "runtime.js", "runtime.d.ts", "browser.js", "browser.d.ts", "browser-worker.js", "pkg/", "pkg-sampler/", "LICENSE-APACHE", "LICENSE-MIT", "README.md"],
  "scripts": {
    "build:wasm": "make -C .. wasm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habakan/tapewasm.git"
  },
  "homepage": "https://github.com/habakan/tapewasm#readme",
  "keywords": ["autodiff", "gradient", "bayesian", "mcmc", "nuts", "webassembly", "wasm"],
  "license": "MIT OR Apache-2.0"
}
